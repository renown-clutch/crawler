FROM python:3.11-slim

# Install system dependencies (only what's needed for FastAPI/uvicorn)
RUN apt-get update && apt-get install -y \
    gcc \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN python -m venv /opt/venv \
    && . /opt/venv/bin/activate \
    && pip install --no-cache-dir -r requirements.txt
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY . .

# Expose HTTP port
EXPOSE 80

# Set environment variables for production
ENV PYTHONUNBUFFERED=1
ENV PYTHONIOENCODING=utf-8
ENV ENV=production

# Command to run FastAPI with uvicorn in production mode (HTTP only)
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "80", "--proxy-headers", "--forwarded-allow-ips=*"] 